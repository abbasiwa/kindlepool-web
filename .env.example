# KindlePool Web — environment configuration
# Copy to .env for local development. Vercel env vars use VITE_ prefix.

# Indexer API base URL (Heroku backend or local)
VITE_INDEXER_URL=https://kindlepool-api.herokuapp.com

# Relayer API base URL
VITE_RELAYER_URL=https://kindlepool-api.herokuapp.com

# Deployed SponsorPool contract ID (testnet)
VITE_KINDLEPOOL_CONTRACT_ID=

# Stellar RPC URL (testnet by default)
VITE_KINDPOOL_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
VITE_KINDPOOL_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
